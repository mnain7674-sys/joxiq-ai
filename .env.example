# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional. Unlocks OpenAI models like GPT-5 mini, GPT-4o.
# Obtain from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ANTHROPIC_API_KEY: Optional. Unlocks Anthropic Claude models like Claude 3 Haiku.
# Obtain from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin credentials (stored securely on backend)
ADMIN_EMAIL="mnain7674@gmail.com"
ADMIN_PASSWORD="#**?6251(JNM-369-captain)"

# Stripe Integration Credentials (Optional: if omitted, app falls back to beautiful simulation)
STRIPE_SECRET_KEY=

# Real Email Delivery Service Credentials (Optional: Resend, SendGrid, or Nodemailer SMTP)
# Option A: Resend API Key (starts with re_)
RESEND_API_KEY=

# Option B: SendGrid API Key (starts with SG.)
SENDGRID_API_KEY=

# Option C: Standard SMTP Credentials
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=mnain7674@gmail.com
EMAIL_SMTP_PASS=

# Cloudflare Enterprise WAF Firewall Integration (Optional: Auto-blocks malicious IPs at edge level)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
